# Neon Postgres connection string. Without it the server stores data in server/data/*.json.
# On Fly.io: fly secrets set DATABASE_URL="postgres://..."
DATABASE_URL=

# Signs session tokens and match results. Any long random string; keep it secret and stable
# (changing it signs everyone out). Generate one with: openssl rand -hex 32
JWT_SECRET=

# Public address used in sign-in emails, e.g. https://pump-royale.fly.dev
PUBLIC_URL=

# Email magic links via Resend (https://resend.com). Without a key, links are only logged.
RESEND_API_KEY=
EMAIL_FROM="Pump Royale <login@yourdomain.com>"

# Error reporting: a Sentry project DSN (Settings → Client Keys). Optional.
SENTRY_DSN=

PORT=8787
